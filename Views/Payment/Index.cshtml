@model IEnumerable<InventoryEnterpriseProject.Core.Entities.Payment>
@{
    ViewData["Title"] = "Payments";
    var total = Model.Where(p => p.Status == "Succeeded").Sum(p => p.Amount);
    var pending = Model.Count(p => p.Status == "Pending");
    var succeeded = Model.Count(p => p.Status == "Succeeded");
}

<div class="space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Payments</h1>
            <p class="text-slate-500 text-sm mt-0.5">All transactions recorded in the system</p>
        </div>
        <a href="/Payment/Create"
           class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl text-sm transition-colors shadow-sm">
            <i class="ph ph-plus text-lg"></i>
            New Payment
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white rounded-2xl border border-slate-200 p-5 flex items-center gap-4">
            <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                <i class="ph-fill ph-currency-dollar text-2xl text-green-600"></i>
            </div>
            <div>
                <p class="text-xs text-slate-500 font-medium uppercase tracking-wide">Total Revenue</p>
                <p class="text-2xl font-bold text-slate-800">$@total.ToString("F2")</p>
            </div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 flex items-center gap-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                <i class="ph-fill ph-check-circle text-2xl text-blue-600"></i>
            </div>
            <div>
                <p class="text-xs text-slate-500 font-medium uppercase tracking-wide">Succeeded</p>
                <p class="text-2xl font-bold text-slate-800">@succeeded</p>
            </div>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-5 flex items-center gap-4">
            <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center">
                <i class="ph-fill ph-clock text-2xl text-amber-600"></i>
            </div>
            <div>
                <p class="text-xs text-slate-500 font-medium uppercase tracking-wide">Pending</p>
                <p class="text-2xl font-bold text-slate-800">@pending</p>
            </div>
        </div>
    </div>

    <!-- Payments Table -->
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h2 class="font-semibold text-slate-800 text-sm">Transaction History</h2>
            <div class="flex items-center gap-3">
                @if (pending > 0)
                {
                    <form method="post" action="/Payment/ClearPending" onsubmit="return confirm('Are you sure you want to permanently delete all pending junk payments?');">
                        <button type="submit" class="text-xs text-red-600 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-lg font-medium transition-colors flex items-center gap-1.5">
                            <i class="ph ph-trash"></i>
                            Clear Pending
                        </button>
                    </form>
                }
                <span class="text-xs text-slate-400 bg-slate-100 px-2.5 py-1 rounded-full">@Model.Count() records</span>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-slate-400">
                <i class="ph ph-credit-card text-5xl mb-3"></i>
                <p class="font-medium">No payments yet</p>
                <p class="text-sm mt-1">Create your first payment to get started</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">ID</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Description</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Amount</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Currency</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var p in Model)
                        {
                            <tr class="hover:bg-slate-50/60 transition-colors">
                                <td class="px-6 py-4 text-slate-400 font-mono text-xs">#@p.Id</td>
                                <td class="px-6 py-4 font-medium text-slate-700">@p.Description</td>
                                <td class="px-6 py-4 font-bold text-slate-800">$@p.Amount.ToString("F2")</td>
                                <td class="px-6 py-4">
                                    <span class="uppercase text-xs font-semibold bg-slate-100 text-slate-600 px-2 py-0.5 rounded">@p.Currency</span>
                                </td>
                                <td class="px-6 py-4">
                                    @if (p.Status == "Succeeded")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-green-50 text-green-700 rounded-full text-xs font-semibold">
                                            <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span> Succeeded
                                        </span>
                                    }
                                    else if (p.Status == "Failed")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-red-50 text-red-700 rounded-full text-xs font-semibold">
                                            <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span> Failed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-amber-50 text-amber-700 rounded-full text-xs font-semibold">
                                            <span class="w-1.5 h-1.5 bg-amber-400 rounded-full"></span> Pending
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-slate-500 text-xs">@p.CreatedAt.ToString("MMM dd, yyyy · HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
