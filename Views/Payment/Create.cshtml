@{
    ViewData["Title"] = "New Payment";
}

<div class="max-w-lg mx-auto space-y-6">

    <!-- Header -->
    <div class="flex items-center gap-3">
        <a href="/Payment" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white border border-slate-200 hover:bg-slate-50 transition text-slate-500">
            <i class="ph ph-arrow-left text-lg"></i>
        </a>
        <div>
            <h1 class="text-xl font-bold text-slate-800">New Payment</h1>
            <p class="text-slate-500 text-xs mt-0.5">Secured by Stripe</p>
        </div>
    </div>

    <!-- Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">

        <!-- Stripe Badge -->
        <div class="bg-gradient-to-r from-blue-600 to-violet-600 px-6 py-4 flex items-center gap-3">
            <i class="ph-fill ph-credit-card text-2xl text-white"></i>
            <div>
                <p class="text-white font-semibold text-sm">Secure Checkout</p>
                <p class="text-blue-100 text-xs">Payments processed by Stripe — PCI DSS compliant</p>
            </div>
        </div>

        <div class="p-6 space-y-5">

            <!-- Description -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Description</label>
                <input id="description" type="text" placeholder="e.g. Invoice #001 — Office Supplies"
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" />
            </div>

            <!-- Amount + Currency -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Amount</label>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 font-semibold text-sm">$</span>
                        <input id="amount" type="number" placeholder="0.00" min="1" step="0.01"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-8 pr-4 py-3 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Currency</label>
                    <select id="currency"
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition">
                        <option value="usd">🇺🇸 USD</option>
                        <option value="eur">🇪🇺 EUR</option>
                        <option value="inr">🇮🇳 INR</option>
                        <option value="gbp">🇬🇧 GBP</option>
                    </select>
                </div>
            </div>

            <!-- Stripe Card Element -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Card Details</label>
                <div id="card-element"
                     class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-3.5 focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-transparent transition">
                </div>
                <p id="card-errors" class="hidden text-xs text-red-500 mt-2 flex items-center gap-1">
                    <i class="ph ph-warning-circle"></i>
                    <span id="error-text"></span>
                </p>
            </div>

            <!-- Test hint -->
            <div class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 flex items-start gap-2.5">
                <i class="ph ph-flask text-amber-500 text-lg mt-0.5 shrink-0"></i>
                <div class="text-xs text-amber-700">
                    <p class="font-semibold mb-0.5">Test Mode — use a test card:</p>
                    <p class="font-mono">4242 4242 4242 4242 · any future date · any CVC</p>
                </div>
            </div>

            <!-- Submit Button -->
            <button id="submit-btn"
                    class="w-full py-3.5 bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 text-white font-bold rounded-xl transition-all flex items-center justify-center gap-2 text-sm">
                <i class="ph-fill ph-lock-key text-lg" id="btn-icon"></i>
                <span id="btn-text">Pay Securely</span>
            </button>
        </div>
    </div>

    <!-- Success State (hidden until payment succeeds) -->
    <div id="success-panel" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-10 text-center">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="ph-fill ph-check-circle text-4xl text-green-500"></i>
        </div>
        <h2 class="text-xl font-bold text-slate-800 mb-2">Payment Successful!</h2>
        <p class="text-slate-500 text-sm mb-6">Your transaction has been recorded and confirmed.</p>
        <a href="/Payment"
           class="inline-flex items-center gap-2 px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl text-sm transition">
            <i class="ph ph-list text-base"></i>
            View All Payments
        </a>
    </div>

</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
    const stripe = Stripe('@ViewBag.PublishableKey');
    const elements = stripe.elements();

    const card = elements.create('card', {
        style: {
            base: {
                color: '#1e293b',
                fontSize: '14px',
                fontFamily: 'Inter, sans-serif',
                fontWeight: '400',
                '::placeholder': { color: '#94a3b8' }
            },
            invalid: { color: '#ef4444' }
        }
    });
    card.mount('#card-element');

    const btn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');
    const cardError = document.getElementById('card-errors');
    const errorText = document.getElementById('error-text');
    const form = document.querySelector('.bg-white.rounded-2xl');
    const successPanel = document.getElementById('success-panel');

    function setError(msg) {
        errorText.textContent = msg;
        cardError.classList.remove('hidden');
    }

    function clearError() {
        cardError.classList.add('hidden');
    }

    function setLoading(loading) {
        btn.disabled = loading;
        btnText.textContent = loading ? 'Processing...' : 'Pay Securely';
        btnIcon.className = loading
            ? 'ph ph-spinner-gap text-lg animate-spin'
            : 'ph-fill ph-lock-key text-lg';
    }

    btn.addEventListener('click', async () => {
        clearError();

        const amount = parseFloat(document.getElementById('amount').value);
        const currency = document.getElementById('currency').value;
        const description = document.getElementById('description').value.trim();

        if (!description) { setError('Please enter a description.'); return; }
        if (!amount || amount <= 0) { setError('Please enter a valid amount.'); return; }

        setLoading(true);

        // 1. Ask server to create a PaymentIntent and return clientSecret
        let data;
        try {
            const res = await fetch('/Payment/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount, currency, description })
            });
            
            data = await res.json();

            if (!res.ok) {
                throw new Error(data.error || data.message || 'Payment failed on server.');
            }
            if (!data.clientSecret) {
                throw new Error('Invalid response from server.');
            }
        } catch (e) {
            setError(e.message || 'Network error — please try again.');
            setLoading(false);
            return;
        }

        // 2. Confirm payment with Stripe.js (handles 3D-Secure automatically)
        try {
            const { error, paymentIntent } = await stripe.confirmCardPayment(data.clientSecret, {
                payment_method: { card }
            });

            if (error) {
                setError(error.message);
                setLoading(false);
            } else if (paymentIntent.status === 'succeeded') {
                
                // Extra failsafe: manually tell the local backend it succeeded
                // (In case Stripe webhooks aren't connected yet)
                await fetch('/Payment/Confirm', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ paymentIntentId: paymentIntent.id })
                });

                document.getElementById('success-panel').classList.remove('hidden');
                document.querySelector('.bg-white.rounded-2xl.border').classList.add('hidden');
            }
        } catch (e) {
            setError('Stripe checkout error: ' + e.message);
            setLoading(false);
        }

    });
</script>
