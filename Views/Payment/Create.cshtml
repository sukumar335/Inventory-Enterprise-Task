@{
    ViewData["Title"] = "New Payment (Razorpay)";
}

<div class="max-w-lg mx-auto space-y-6">

    <!-- Header -->
    <div class="flex items-center gap-3">
        <a href="/Payment" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white border border-slate-200 hover:bg-slate-50 transition text-slate-500">
            <i class="ph ph-arrow-left text-lg"></i>
        </a>
        <div>
            <h1 class="text-xl font-bold text-slate-800">New Payment</h1>
            <p class="text-slate-500 text-xs mt-0.5">Secured by Razorpay</p>
        </div>
    </div>

    <!-- Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden" id="form-panel">

        <!-- Razorpay Badge -->
        <div class="bg-gradient-to-r from-blue-700 to-indigo-800 px-6 py-4 flex items-center gap-3">
            <i class="ph-fill ph-credit-card text-2xl text-white"></i>
            <div>
                <p class="text-white font-semibold text-sm">Secure Checkout</p>
                <p class="text-blue-100 text-xs">Payments processed by Razorpay — PCI DSS compliant</p>
            </div>
        </div>

        <div class="p-6 space-y-5">

            <!-- Description -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Description</label>
                <input id="description" type="text" placeholder="e.g. Invoice #001 — Office Supplies"
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" />
            </div>

            <!-- Amount + Currency -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Amount</label>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 font-semibold text-sm">$</span>
                        <input id="amount" type="number" placeholder="0.00" min="1" step="0.01"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-8 pr-4 py-3 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5 uppercase tracking-wider">Currency</label>
                    <select id="currency"
                            class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition">
                        <option value="inr" selected>🇮🇳 INR</option>
                        <option value="usd">🇺🇸 USD</option>
                        <option value="eur">🇪🇺 EUR</option>
                        <option value="gbp">🇬🇧 GBP</option>
                    </select>
                </div>
            </div>

            <p id="card-errors" class="hidden text-xs text-red-500 mt-2 flex items-center gap-1">
                <i class="ph ph-warning-circle"></i>
                <span id="error-text"></span>
            </p>

            <!-- Test hint -->
            <div class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 flex items-start gap-2.5">
                <i class="ph ph-flask text-amber-500 text-lg mt-0.5 shrink-0"></i>
                <div class="text-xs text-amber-700">
                    <p class="font-semibold mb-0.5">Test Mode Active</p>
                    <p class="font-mono">Use Razorpay test credentials to simulate a payment.</p>
                </div>
            </div>

            <!-- Submit Button -->
            <button id="submit-btn"
                    class="w-full py-3.5 bg-blue-700 hover:bg-blue-800 disabled:bg-slate-300 text-white font-bold rounded-xl transition-all flex items-center justify-center gap-2 text-sm">
                <i class="ph-fill ph-lock-key text-lg" id="btn-icon"></i>
                <span id="btn-text">Pay Securely</span>
            </button>
        </div>
    </div>

    <!-- Success State -->
    <div id="success-panel" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-10 text-center">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="ph-fill ph-check-circle text-4xl text-green-500"></i>
        </div>
        <h2 class="text-xl font-bold text-slate-800 mb-2">Payment Successful!</h2>
        <p class="text-slate-500 text-sm mb-6">Your transaction was processed by Razorpay.</p>
        <a href="/Payment"
           class="inline-flex items-center gap-2 px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl text-sm transition">
            <i class="ph ph-list text-base"></i>
            View All Payments
        </a>
    </div>

</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    const btn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');
    const cardError = document.getElementById('card-errors');
    const errorText = document.getElementById('error-text');

    function setError(msg) {
        errorText.textContent = msg;
        cardError.classList.remove('hidden');
    }

    function clearError() {
        cardError.classList.add('hidden');
    }

    function setLoading(loading) {
        btn.disabled = loading;
        btnText.textContent = loading ? 'Processing...' : 'Pay Securely';
        btnIcon.className = loading
            ? 'ph ph-spinner-gap text-lg animate-spin'
            : 'ph-fill ph-lock-key text-lg';
    }

    btn.addEventListener('click', async () => {
        clearError();

        const amount = parseFloat(document.getElementById('amount').value);
        const currency = document.getElementById('currency').value.toUpperCase();
        const description = document.getElementById('description').value.trim();

        if (!description) { setError('Please enter a description.'); return; }
        if (!amount || amount <= 0) { setError('Please enter a valid amount.'); return; }

        setLoading(true);

        // 1. Create Order on the server
        let data;
        try {
            const res = await fetch('/Payment/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount, currency, description })
            });

            const responseData = await res.json();
            
            if (!res.ok) throw new Error(responseData.error || 'Payment failed on server.');
            if (!responseData.orderId) throw new Error('Razorpay order ID missing from server.');
                
            data = responseData;
        } catch (e) {
            setError(e.message || 'Network error — please try again.');
            setLoading(false);
            return;
        }

        // 2. Open Razorpay Checkout modal
        const options = {
            "key": "@ViewBag.KeyId",
            "amount": amount * 100, // paise
            "currency": currency,
            "name": "Stock Master",
            "description": description,
            "order_id": data.orderId,
            "handler": async function (response) {
                // Payment succeeded
                // 3. Confirm payment on our backend
                try {
                    const confirmRes = await fetch('/Payment/Confirm', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            razorpayOrderId: response.razorpay_order_id,
                            razorpayPaymentId: response.razorpay_payment_id,
                            razorpaySignature: response.razorpay_signature
                        })
                    });

                    if (confirmRes.ok) {
                        document.getElementById('success-panel').classList.remove('hidden');
                        document.getElementById('form-panel').classList.add('hidden');
                    } else {
                        setError("Verification failed on server.");
                        setLoading(false);
                    }
                } catch (e) {
                    setError("Network error confirming payment.");
                    setLoading(false);
                }
            },
            "prefill": {
                "name": "John Doe",
                "email": "johndoe@example.com",
                "contact": "9999999999"
            },
            "theme": {
                "color": "#1d4ed8" // blue-700
            },
            "modal": {
                "ondismiss": function(){
                    setLoading(false);
                }
            }
        };

        const rzp1 = new Razorpay(options);
        rzp1.on('payment.failed', function (response){
            setError(response.error.description);
            setLoading(false);
        });
        
        rzp1.open();
    });
</script>
